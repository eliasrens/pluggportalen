rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Hjälpfunktioner. Se docs/security-plan.md §3.4.
    // request.auth finns bara med äkta Firebase Auth (src/auth.js). Utan
    // inloggning är request.auth == null och allt nedan faller igenom till
    // den avslutande "neka allt"-regeln.
    // ------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    // Lärare = Auth-användare med custom claim teacher:true
    // (sätts en gång via admin/set-teacher-claim.mjs).
    function isTeacher() { return signedIn() && request.auth.token.teacher == true; }
    // Eleven själv = den inloggades uid == dokumentets id (uid sattes = det
    // gamla doc-id:t vid migreringen, se admin/migrate-passwords.mjs).
    function isSelf(id)  { return signedIn() && request.auth.uid == id; }

    // Klass-scopad kamratläsning (klassbyn, #/elev/by). En elev får läsa en
    // ANNAN elevs students/studentData ENDAST om de delar minst en klass.
    // Klasstillhörigheten är denormaliserad som students/{id}.classIds (en
    // lista klass-id:n) eftersom regler inte kan loopa över classes-kollektionen
    // för att hitta en gemensam klass. Fältet underhålls av läraren via
    // data.setClassStudents/deleteClass och backfillas med
    // admin/backfill-class-ids.mjs. Saknat/tomt classIds ⇒ ingen kamratåtkomst
    // (fail-closed): en klasslös elev når bara sitt eget.
    function classIdsOf(id) {
      return exists(/databases/$(database)/documents/students/$(id))
        ? get(/databases/$(database)/documents/students/$(id)).data.get('classIds', [])
        : [];
    }
    function sharesClass(id) {
      return signedIn() && classIdsOf(request.auth.uid).hasAny(classIdsOf(id));
    }
    // Är den inloggade medlem i klassen classId? (Elevens denormaliserade
    // classIds avgör – reglerna kan inte loopa över classes.) Används för att
    // låta en elev uppdatera SIN EGEN klass gemensamma aggregat (classStats).
    function isClassMember(classId) {
      return signedIn() && classIdsOf(request.auth.uid).hasAny([classId]);
    }

    // Kunskapsinnehåll (ämnen/arbetsområden): alla INLOGGADE får läsa;
    // bara lärare skriver. Inget world-read längre.
    match /subjects/{subjectId} {
      allow read:  if signedIn();
      allow write: if isTeacher();
      match /areas/{areaId} {
        allow read:  if signedIn();
        allow write: if isTeacher();
      }
    }

    // Elevkonton: eleven läser SITT eget dokument, lärare läser/skriver alla.
    // Inga lösenord finns kvar här (de bor i Firebase Auth) → ingen världsläsbar
    // lösenordslista. Elever kan inte skapa/ändra konton (bara läraren).
    //
    // LÄSNING (#114): öppen för ALLA inloggade. Grannby-vyn (#/elev/grannby) ska
    // kunna gå in i en ANNAN klass elevers hus/rum som läs-vy (produktägar-beslut,
    // river #37 för utseende-data mellan klasser). students-dokumentet bär bara
    // namn/avatar/klasstillhörighet – inga lösenord/coins/progress – så det är
    // ofarligt att låta alla inloggade läsa det. Skrivning: fortfarande bara läraren.
    match /students/{studentId} {
      allow read:  if signedIn();
      allow write: if isTeacher();
    }

    // Elevdata (framsteg, pluggcoins, shop-saker, rummets placering): eleven
    // äger sitt eget; lärare läser alla (klassöversikt) och skriver (ge coins).
    // En klasskamrat (samma klass, sharesClass) får LÄSA – byn/kompisrummet visar
    // hus, avatar och palett – men aldrig skriva. Endast eleven själv/läraren skriver.
    //
    // HUSLÅS (#33 + Epic C:s by-fix): fältet `husLast` (bool) på studentData. När
    // det är true NEKAS annan-elev-läsning här på servern (läs-grenen kräver
    // `resource.data.husLast != true`), så låset går INTE att kringgå enbart
    // klient-sida. Eleven själv och läraren läser alltid (även när det är låst).
    // Byn tål detta: getStudentsWithLooks (data-content.js) fångar nekad läsning
    // PER elev och visar då default-utseende (ett låst hus = generiskt hus i byn),
    // och klasskamratens läs-vy (pages-klasskamrat.js) visar "🔒 Låst" när läsning
    // nekas. husLast saknas på gamla dokument → `!= true` → olåst (läsbart).
    //
    // LÄSNING (#114): tidigare var annan-elev-läsning scopad till samma klass
    // (sharesClass). Grannby-vyn ska nu kunna gå in i en ANNAN klass elevers rum
    // som läs-vy → läsning öppnas för ALLA inloggade, MEN huslås-guarden behålls
    // oförändrad (en låst elevs rum går inte att kika in i, varken inom eller
    // mellan klasser). OBS: studentData bär även coins/progress/inventarie – de
    // blir därmed tekniskt läsbara mellan klasser (klasskamrater hade redan den
    // åtkomsten inom klassen). Appen visar aldrig andras coins/progress. Detta är
    // ett medvetet produktägar-beslut (#114). Skrivning: fortfarande bara eleven
    // själv/läraren – ingen kan ändra en annan elevs data.
    match /studentData/{studentId} {
      allow read:  if isTeacher() || isSelf(studentId) || (signedIn() && resource.data.get('husLast', false) != true);
      allow write: if isTeacher() || isSelf(studentId);
    }

    // Utseende-projektion (#114): en PUBLIK (för inloggade) spegling av en elevs
    // COSMETISKA fält – namn, grundavatar, burna kläder, hus-palett, husskal och
    // huslås-flaggan. Grannby-ÖVERSIKTEN (#/elev/grannby) läser den för alla
    // elever i den klickade klassen för att rita deras riktiga hus/avatarer utan
    // att röra studentData (som bär coins/progress). Skrivs (denormaliseras) av
    // eleven SJÄLV när dess utseende laddas/ändras – best-effort, en nekad/
    // misslyckad skrivning fäller aldrig vyn. Skrivning är låst till isSelf +
    // en VITLISTA av fält med typkoll, så projektionen inte kan missbrukas.
    // Läsning öppen för alla inloggade (bara kosmetik, inga känsliga fält).
    match /looks/{studentId} {
      allow read:  if signedIn();
      allow write: if isSelf(studentId)
        && request.resource.data.keys().hasOnly(
             ['namn', 'avatarId', 'avatarItems', 'paletteId', 'husSkalId', 'husLast', 'updatedAt'])
        && request.resource.data.namn is string
        && request.resource.data.avatarId is string
        && request.resource.data.avatarItems is list
        && request.resource.data.paletteId is string
        && request.resource.data.husSkalId is string
        && request.resource.data.husLast is bool;
    }

    // Klasser: alla inloggade läser (eleven behöver sin tilldelning);
    // bara lärare skriver.
    match /classes/{classId} {
      allow read:  if signedIn();
      allow write: if isTeacher();
    }

    // Klass-aggregat: gemensamt klass-aggregat per klass (classStats/{classId}).
    // #113 speglade bara { totalStars }; #114 utökar det till hela klassaggregatet
    // (totalStars, totalXp, totalCompleted, level, progressRatio) så grannby-vyn
    // kan visa en ANNAN klass stjärn-skylt IDENTISKT med hur klassen själv ser
    // den (samma ✨-toggle + stats). Läs-öppet för alla inloggade – bara
    // klasstotaler, aldrig per-elev-data. Skrivs av läraren ELLER av en elev i
    // klassen (speglar sin egen klass aggregat när byn laddas); en elev får BARA
    // sätta de vitlistade fälten (inga godtyckliga fält). De extra aggregat-fälten
    // är valfria (bakåtkompatibelt med #113:s totalStars-bara-skrivning) men
    // typkollas när de finns, så aggregatet inte kan missbrukas.
    match /classStats/{classId} {
      allow read:  if signedIn();
      allow write: if isTeacher() ||
        (isClassMember(classId)
          && request.resource.data.keys().hasOnly(
               ['totalStars', 'totalXp', 'totalCompleted', 'level', 'progressRatio', 'updatedAt'])
          && request.resource.data.totalStars is number
          && request.resource.data.get('totalXp', 0) is number
          && request.resource.data.get('totalCompleted', 0) is number
          && request.resource.data.get('level', 0) is number
          && request.resource.data.get('progressRatio', 0) is number);
    }

    // Allt annat nekas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
