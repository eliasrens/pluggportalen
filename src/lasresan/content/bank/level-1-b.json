      {
        "id": "q1",
        "question": "Vad andas fisken med?",
        "options": [
          "Fenor",
          "Fjäll",
          "Gälar",
          "Näsan"
        ],
        "answerIndex": 2,
        "category": "fakta"
      },
      {
        "id": "q2",
        "question": "Vad gör fisken med fenorna?",
        "options": [
          "Äter",
          "Andas",
          "Simmar",
          "Sover"
        ],
        "answerIndex": 2,
        "category": "fakta"
      },
      {
        "id": "q3",
        "question": "Vad är fiskens kropp ofta täckt av?",
        "options": [
          "Päls",
          "Fjäll",
          "Fjädrar",
          "Taggar"
        ],
        "answerIndex": 1,
        "category": "fakta"
      },
      {
        "id": "q4",
        "question": "Var sitter gälarna?",
        "options": [
          "Längst ut på svansen",
          "Mitt på ryggen",
          "Under magen",
          "På sidan av huvudet"
        ],
        "answerIndex": 3,
        "category": "fakta"
      }
    ]
  },
