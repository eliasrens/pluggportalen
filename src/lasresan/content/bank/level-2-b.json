          "En snöhög"
        ],
        "answerIndex": 2,
        "category": "fakta"
      },
      {
        "id": "q2",
        "question": "Vad finns inne i stacken?",
        "options": [
          "Gångar och rum",
          "Vatten och sand",
          "Blommor och gräs",
          "Stenar och lera"
        ],
        "answerIndex": 0,
